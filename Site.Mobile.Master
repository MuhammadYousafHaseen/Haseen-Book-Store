<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Mobile.master.cs" Inherits="BookStoreWebForms.Site_Mobile" %>
<%@ Register Src="~/ViewSwitcher.ascx" TagPrefix="friendlyUrls" TagName="ViewSwitcher" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%: Page.Title %> | Haseen Books Store</title>

    <asp:ContentPlaceHolder runat="server" ID="HeadContent" />

    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --light-blue: #eff6ff;
            --text: #1e293b;
            --muted: #64748b;
            --border: #e2e8f0;
            --white: #ffffff;
        }

        * {
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            background: #f8fafc;
            color: var(--text);
            font-family: "Segoe UI", Arial, sans-serif;
            line-height: 1.6;
        }

        .mobile-navbar {
            padding: 15px 18px;
            background: var(--white);
            border-bottom: 1px solid var(--border);
            box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
        }

        .mobile-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text);
            text-decoration: none;
        }

        .mobile-brand:hover {
            color: var(--primary);
        }

        .mobile-brand-icon {
            display: flex;
            flex-shrink: 0;
            width: 44px;
            height: 44px;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            color: var(--white);
            font-size: 23px;
        }

        .mobile-brand-name {
            display: block;
            font-size: 1.15rem;
            font-weight: 800;
            line-height: 1.3;
        }

        .mobile-brand-tagline {
            display: block;
            margin-top: 3px;
            color: var(--muted);
            font-size: 0.68rem;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .mobile-nav-links {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 15px;
        }

        .mobile-nav-links a {
            padding: 8px 12px;
            border-radius: 9px;
            background: var(--light-blue);
            color: var(--primary-dark);
            font-size: 0.88rem;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.2s ease;
        }

        .mobile-nav-links a:hover {
            background: #dbeafe;
        }

        .mobile-main {
            width: 100%;
            max-width: 900px;
            flex: 1 0 auto;
            margin: 0 auto;
            padding: 24px 16px 36px;
        }

        .mobile-main img {
            max-width: 100%;
            height: auto;
        }

        .mobile-main input,
        .mobile-main select,
        .mobile-main textarea {
            max-width: 100%;
        }

        .mobile-footer {
            padding: 22px 16px;
            background: var(--white);
            border-top: 1px solid var(--border);
            text-align: center;
        }

        .mobile-footer-name {
            margin: 0;
            font-size: 0.95rem;
            font-weight: 700;
        }

        .mobile-footer-copy {
            margin: 5px 0 0;
            color: var(--muted);
            font-size: 0.82rem;
        }

        .mobile-view-switcher {
            margin-top: 12px;
            font-size: 0.85rem;
        }

        .mobile-view-switcher a {
            color: var(--primary);
        }

        a:focus-visible,
        input:focus-visible,
        button:focus-visible,
        select:focus-visible,
        textarea:focus-visible {
            outline: 3px solid rgba(37, 99, 235, 0.35);
            outline-offset: 2px;
        }

        @media (max-width: 360px) {
            .mobile-brand-name {
                font-size: 1rem;
            }

            .mobile-brand-tagline {
                font-size: 0.62rem;
            }

            .mobile-main {
                padding-right: 12px;
                padding-left: 12px;
            }
        }
    </style>
</head>

<body>
    <form id="form1" runat="server">

        <!-- Store branding and mobile navigation -->
        <header class="mobile-navbar">
            <a class="mobile-brand" runat="server" href="~/">
                <span class="mobile-brand-icon" aria-hidden="true">&#128214;</span>

                <span>
                    <span class="mobile-brand-name">Haseen Books Store</span>
                    <span class="mobile-brand-tagline">Stories Worth Reading</span>
                </span>
            </a>

            <nav class="mobile-nav-links" aria-label="Main navigation">
                <a runat="server" href="~/">Home</a>
                <a runat="server" href="~/Books.aspx">Browse Books</a>
                <a runat="server" href="~/Categories.aspx">Categories</a>
                <a runat="server" href="~/About">About</a>
                <a runat="server" href="~/Contact">Contact</a>
            </nav>
        </header>

        <!-- Page-specific content -->
        <main class="mobile-main">
            <asp:ContentPlaceHolder runat="server" ID="FeaturedContent" />

            <section class="content-wrapper main-content">
                <asp:ContentPlaceHolder runat="server" ID="MainContent" />
            </section>
        </main>

        <!-- Footer -->
        <footer class="mobile-footer">
            <p class="mobile-footer-name">Haseen Books Store</p>

            <p class="mobile-footer-copy">
                &copy; <%: DateTime.Now.Year %> Haseen Books Store.
                All rights reserved.
            </p>

            <div class="mobile-view-switcher">
                <friendlyUrls:ViewSwitcher runat="server" />
            </div>
        </footer>

    </form>
</body>
</html>
